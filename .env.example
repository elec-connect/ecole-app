# ⚠️ SEUL secret en variable d'environnement.
# Tout le reste (DATABASE_URL, JWT_SECRET, SMTP...) est stocké chiffré dans la table `Configuration`.
# Générer avec : npm run generate-key
CONFIG_ENCRYPTION_KEY="base64_32_bytes_key_here"

# URL publique de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bootstrap : valeurs initiales pour la première config
BOOTSTRAP_DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
BOOTSTRAP_ADMIN_EMAIL="admin@ecole.tn"
BOOTSTRAP_ADMIN_PASSWORD="ChangezMoi123!"