generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PROFESSEUR
  ETUDIANT
  PARENT
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  JUSTIFIE
}

enum TypeNote {
  CONTROLE
  EXAMEN
  DEVOIR
}

enum StatutDemande {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

enum StatutPaiement {
  PAYE
  IMPAYE
  PARTIEL
}

enum MoisScolaire {
  SEPTEMBRE
  OCTOBRE
  NOVEMBRE
  DECEMBRE
  JANVIER
  FEVRIER
  MARS
  AVRIL
  MAI
  JUIN
  JUILLET
  AOUT
}

enum StatutSeance {
  EN_ATTENTE
  CONFIRMEE
  REJETEE
}

model Configuration {
  id          String   @id @default("singleton")
  donnees     String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  motDePasse  String
  nom         String
  prenom      String
  role        Role
  actif       Boolean  @default(true)
  emailParent String?
  createdAt   DateTime @default(now())

  coursProf      Cours[]       @relation("ProfCours")
  coursPrincipal Classe[]      @relation("ProfPrincipal")
  notes          Note[]
  presences      Presence[]
  inscriptions   Inscription[]
  messagesEnv    Message[]     @relation("Expediteur")
  messagesRec    Message[]     @relation("Destinataire")
  matieres       Matiere[]     @relation("ProfMatieres")
  enfants        ParentEleve[] @relation("Parent")
  parents        ParentEleve[] @relation("Eleve")

  demandesInscriptionEtudiant DemandeInscription[] @relation("DemandeInscriptionEtudiant")
  demandesInscriptionParent   DemandeInscription[] @relation("DemandeInscriptionParent")
  notifications               Notification[]       @relation("NotificationDestinataire")
  fraisScolarite              FraisScolarite[]     @relation("FraisEleve")
  tarifsProfesseur            TarifProfesseur[]    @relation("TarifProf")
  seancesDeclarees            SeanceTravail[]      @relation("SeancesProf")
  seancesTraitees             SeanceTravail[]      @relation("SeancesTraitees")
  annoncesProf                Annonce[]            @relation("AnnoncesProf")

  // ⭐ INDEX : recherche par rôle + statut actif
  @@index([role, actif])
}

model ParentEleve {
  id       String  @id @default(cuid())
  parentId String
  eleveId  String
  relation String?

  parent User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  eleve  User @relation("Eleve", fields: [eleveId], references: [id], onDelete: Cascade)

  @@unique([parentId, eleveId])
}

model Classe {
  id                    String @id @default(cuid())
  nom                   String
  niveau                String
  anneeScolaire         String
  professeurPrincipalId String?

  professeurPrincipal User?           @relation("ProfPrincipal", fields: [professeurPrincipalId], references: [id])
  inscriptions        Inscription[]
  cours               Cours[]
  volumes             VolumeHoraire[]
  annonces            Annonce[]

  @@unique([nom, anneeScolaire])
}

model Matiere {
  id               String @id @default(cuid())
  nom              String @unique
  coefficient      Int    @default(1)
  heuresParSemaine Int    @default(2)

  cours       Cours[]
  notes       Note[]
  professeurs User[]          @relation("ProfMatieres")
  salles      Salle[]         @relation("SalleMatieres")
  volumes     VolumeHoraire[]
}

model Salle {
  id        String   @id @default(cuid())
  nom       String   @unique
  capacite  Int?
  type      String?
  batiment  String?
  createdAt DateTime @default(now())

  cours    Cours[]
  matieres Matiere[] @relation("SalleMatieres")
}

model VolumeHoraire {
  id          String @id @default(cuid())
  classeId    String
  matiereId   String
  heures      Int    @default(2)
  coefficient Int    @default(1)

  classe  Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([classeId, matiereId])
}

model Cours {
  id           String @id @default(cuid())
  classeId     String
  matiereId    String
  professeurId String
  jourSemaine  Int
  heureDebut   String
  heureFin     String
  salleId      String?

  classe      Classe         @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere     Matiere        @relation(fields: [matiereId], references: [id])
  professeur  User           @relation("ProfCours", fields: [professeurId], references: [id])
  salle       Salle?         @relation(fields: [salleId], references: [id])
  presences   Presence[]
  devoirs     Devoir[]
  evaluations Evaluation[]
  seances     SeanceTravail[]

  // ⭐ INDEX : recherche par classe + jour + heure, et par prof + jour
  @@index([classeId, jourSemaine, heureDebut])
  @@index([professeurId, jourSemaine])
}

model Inscription {
  id            String @id @default(cuid())
  etudiantId    String
  classeId      String
  anneeScolaire String

  etudiant User   @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  @@unique([etudiantId, classeId, anneeScolaire])
  // ⭐ INDEX : recherche par classe + année, et par étudiant + année
  @@index([classeId, anneeScolaire])
  @@index([etudiantId, anneeScolaire])
}

model Presence {
  id         String         @id @default(cuid())
  coursId    String
  etudiantId String
  date       DateTime
  statut     StatutPresence

  cours    Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)
  etudiant User  @relation(fields: [etudiantId], references: [id], onDelete: Cascade)

  @@unique([coursId, etudiantId, date])
  // ⭐ INDEX : recherche par étudiant + date, et par cours + date
  @@index([etudiantId, date])
  @@index([coursId, date])
}

model Evaluation {
  id          String   @id @default(cuid())
  coursId     String
  nom         String
  type        TypeNote
  coefficient Int      @default(1)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  cours Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)
  notes Note[]

  @@unique([coursId, nom])
}

model Note {
  id           String   @id @default(cuid())
  etudiantId   String
  matiereId    String
  evaluationId String?
  type         TypeNote
  valeur       Float
  coefficient  Int      @default(1)
  date         DateTime @default(now())
  commentaire  String?

  etudiant   User        @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  matiere    Matiere     @relation(fields: [matiereId], references: [id])
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([etudiantId, evaluationId])
  // ⭐ INDEX : recherche par étudiant + matière, et par matière + date
  @@index([etudiantId, matiereId])
  @@index([matiereId, date])
}

model Devoir {
  id          String   @id @default(cuid())
  coursId     String
  titre       String
  description String?
  deadline    DateTime
  fichierUrl  String?

  cours Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)
}

model Message {
  id             String   @id @default(cuid())
  expediteurId   String
  destinataireId String
  contenu        String
  lu             Boolean  @default(false)
  createdAt      DateTime @default(now())

  expediteur   User @relation("Expediteur", fields: [expediteurId], references: [id])
  destinataire User @relation("Destinataire", fields: [destinataireId], references: [id])

  // ⭐ INDEX : recherche des messages non lus, et par expéditeur
  @@index([destinataireId, lu, createdAt])
  @@index([expediteurId, createdAt])
}

model Archive {
  id            String   @id @default(cuid())
  anneeScolaire String
  nom           String
  type          String
  format        String
  contenu       String   @db.Text
  nbEleves      Int      @default(0)
  nbNotes       Int      @default(0)
  nbClasses     Int      @default(0)
  createdAt     DateTime @default(now())
  createdById   String?
}

model DemandeInscription {
  id            String        @id @default(cuid())
  nom           String
  prenom        String
  emailEleve    String
  emailParent   String
  nomParent     String
  prenomParent  String
  telephone     String?
  niveauDemande String
  statut        StatutDemande @default(EN_ATTENTE)
  motifRejet    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  etudiantId String?
  etudiant   User? @relation("DemandeInscriptionEtudiant", fields: [etudiantId], references: [id])

  parentId String?
  parent   User? @relation("DemandeInscriptionParent", fields: [parentId], references: [id])
}

model Notification {
  id             String   @id @default(cuid())
  type           String
  message        String
  lien           String?
  lu             Boolean  @default(false)
  destinataireId String
  destinataire   User     @relation("NotificationDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([destinataireId, lu])
}

// ============================================================
// COMPTABILITÉ — ÉLÈVES
// ============================================================

model FraisScolarite {
  id             String   @id @default(cuid())
  eleveId        String
  anneeScolaire  String
  montantMensuel Float
  description    String?
  createdAt      DateTime @default(now())

  eleve     User       @relation("FraisEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  paiements Paiement[]

  @@unique([eleveId, anneeScolaire])
}

model Paiement {
  id           String         @id @default(cuid())
  fraisId      String
  mois         MoisScolaire
  montant      Float
  datePaiement DateTime       @default(now())
  methode      String?
  reference    String?
  statut       StatutPaiement @default(PAYE)
  createdAt    DateTime       @default(now())

  frais FraisScolarite @relation(fields: [fraisId], references: [id], onDelete: Cascade)

  @@unique([fraisId, mois])
}

// ============================================================
// COMPTABILITÉ — PROFESSEURS (paie mensuelle)
// ============================================================

model TarifProfesseur {
  id            String   @id @default(cuid())
  professeurId  String
  anneeScolaire String
  tauxHoraire   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  professeur User             @relation("TarifProf", fields: [professeurId], references: [id], onDelete: Cascade)
  paiements  PaieProfesseur[]

  @@unique([professeurId, anneeScolaire])
}

model PaieProfesseur {
  id                String         @id @default(cuid())
  tarifId           String
  mois              MoisScolaire
  heuresTravaillees Float
  tauxHoraire       Float
  montant           Float
  datePaiement      DateTime       @default(now())
  methode           String?
  reference         String?
  statut            StatutPaiement @default(PAYE)
  createdAt         DateTime       @default(now())

  tarif TarifProfesseur @relation(fields: [tarifId], references: [id], onDelete: Cascade)

  @@unique([tarifId, mois])
}

// ============================================================
// SÉANCES DE TRAVAIL (déclarées par le prof, validées par l'admin)
// ============================================================

model SeanceTravail {
  id              String       @id @default(cuid())
  professeurId    String
  coursId         String?
  date            DateTime
  heuresDeclarees Float
  heuresValidees  Float?
  description     String?
  statut          StatutSeance @default(EN_ATTENTE)
  motifRejet      String?
  declareLe       DateTime     @default(now())
  traiteLe        DateTime?
  traiteParId     String?
  horsEmploi      Boolean      @default(false)

  professeur User   @relation("SeancesProf", fields: [professeurId], references: [id], onDelete: Cascade)
  cours      Cours? @relation(fields: [coursId], references: [id], onDelete: SetNull)
  traitePar  User?  @relation("SeancesTraitees", fields: [traiteParId], references: [id])

  @@index([professeurId, date])
  @@index([statut])
}

model Annonce {
  id           String    @id @default(cuid())
  titre        String
  contenu      String
  type         String    @default("INFO")
  classeId     String
  professeurId String
  createdAt    DateTime  @default(now())
  expireLe     DateTime?

  classe     Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)
  professeur User   @relation("AnnoncesProf", fields: [professeurId], references: [id], onDelete: Cascade)

  @@index([classeId, createdAt])
}